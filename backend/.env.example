# Meta WhatsApp Cloud API
META_VERIFY_TOKEN=your_webhook_verify_token_here
META_ACCESS_TOKEN=your_meta_permanent_access_token_here
META_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# SMS defaults
# Each Nexa client can override these credentials from the SMS Provider page.
SMS_PROVIDER=blessed
BLESSED_API_KEY=your_blessed_text_api_key
BLESSED_SENDER_ID=your_blessed_text_sender_id
BLESSED_API_URL=https://sms.blessedtexts.com/api/sms/v1/sendsms
SAVVY_API_KEY=your_savvy_api_key
SAVVY_PARTNER_ID=your_savvy_partner_id
SAVVY_SENDER_ID=your_savvy_sender_id
SAVVY_API_URL=https://sms.savvybulksms.com/api/services/sendsms/

# Safaricom Daraja / M-Pesa collection gateway
# Keep real credentials in the production environment or save them through the authenticated M-Pesa settings API.
DARAJA_ENABLED=false
DARAJA_CONSUMER_KEY=your_daraja_consumer_key
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret
DARAJA_SHORTCODE=your_paybill_or_till_shortcode
DARAJA_PASSKEY=your_lipa_na_mpesa_online_passkey
DARAJA_ENVIRONMENT=production
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
DARAJA_CALLBACK_SECRET=replace_with_a_long_random_secret
PUBLIC_BACKEND_URL=https://your-public-backend.example.com

# Polyizon direct-bank STK routing
# When enabled, Polyizon uses the central Daraja credentials above and routes the STK itself
# to the ISP's active, encrypted Equity (247247) or Co-operative Bank (400200) account.
# Keep false until the code and production configuration have been verified.
DARAJA_DIRECT_BANK_ENABLED=false

# Safaricom Daraja B2B bank settlement rail (optional/fallback; not used by direct-bank STK collection)
# Uses the same Daraja consumer key/secret and Polyizon business shortcode above.
# Initiator/security credential are issued/enabled for B2B on the M-Pesa business shortcode.
DARAJA_B2B_ENABLED=false
DARAJA_B2B_ENVIRONMENT=production
DARAJA_B2B_SHORTCODE=your_polyizon_paybill_shortcode
DARAJA_B2B_INITIATOR=your_mpesa_b2b_initiator
DARAJA_B2B_SECURITY_CREDENTIAL=your_encrypted_mpesa_security_credential

# ISP bank settlement profiles
# 32-byte key encoded as 64 hexadecimal characters. Generate once and keep it stable in production.
SETTLEMENT_ENCRYPTION_KEY=replace_with_64_hex_characters
PAYMENT_ROUTER_ENABLED=true

# Optional KCB Buni adapter.
KCB_BUNI_ENABLED=false
KCB_BUNI_ENVIRONMENT=sandbox
KCB_BUNI_CLIENT_ID=your_kcb_buni_client_id
KCB_BUNI_CLIENT_SECRET=your_kcb_buni_client_secret
KCB_BUNI_TOKEN_URL=
KCB_BUNI_API_BASE_URL=
KCB_BUNI_COMMERCIAL_APPROVED=false
KCB_BUNI_TIMEOUT_MS=20000

# PostgreSQL — use docker-compose for local dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_support

# Auth
JWT_SECRET=change_this_to_a_long_random_string_in_production

# Server
PORT=3001

# Frontend origin (for CORS)
FRONTEND_URL=http://localhost:5173