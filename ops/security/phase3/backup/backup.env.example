NEXA_LOCAL_REPOSITORY=/var/backups/nexa-restic
NEXA_LOCAL_PASSWORD_FILE=/etc/nexa-backup/restic-password

# Phase 3 is not complete until a physically separate repository is configured.
# Supported Restic examples include s3:s3.amazonaws.com/bucket/nexa and sftp:user@host:/backups/nexa.
NEXA_OFFSITE_REPOSITORY=
NEXA_OFFSITE_PASSWORD_FILE=
