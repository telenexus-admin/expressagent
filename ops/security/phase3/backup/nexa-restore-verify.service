[Unit]
Description=Verify Nexa backup by full disposable PostgreSQL restore
After=network-online.target postgresql.service nexa-backup.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/nexa-restore-verify
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/nexa-restic /var/lib/nexa-backup /var/lib/postgresql /run/lock
