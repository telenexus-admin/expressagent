GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_PORT=3090
GATEWAY_SHARED_SECRET=replace-with-a-long-random-secret
ARI_URL=http://127.0.0.1:8088/ari
ARI_USERNAME=nexa_gateway
ARI_PASSWORD=replace-me
ARI_APP=nexa-voice-gateway
MEDIA_CODEC=ulaw
MAX_CALL_SECONDS=1800

EXTERNAL_MEDIA_PORT=12000
EXTERNAL_MEDIA_PORT_MAX=12100

OPENAI_API_KEY=replace-with-your-existing-openai-key
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_VOICE=marin
OPENAI_VOICE_SPEED=1
OPENAI_VAD_THRESHOLD=0.5
OPENAI_VAD_PREFIX_PADDING_MS=300
OPENAI_VAD_SILENCE_MS=500

NEXA_AGENT_PROMPT=You are Nexa, the AI voice assistant for Telenexus Technologies. Speak naturally, clearly, briefly, and professionally. Never invent facts or claim an action happened unless the system confirms it.
NEXA_GREETING=Greet the caller as Nexa and ask how you can help. Keep the greeting short and natural for a telephone conversation.
